{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "DeadlineReminders": {
    "LeadTime": "00:15:00",
    "PollInterval": "00:00:10",
    "LeaseDuration": "00:02:00",
    "BatchSize": 100,
    "MaxConcurrency": 8
  },
  "AllowedHosts": "*"
}
