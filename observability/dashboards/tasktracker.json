{
  "title": "TaskTracker Overview",
  "uid": "tasktracker-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Service Status",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "up", "legendFormat": "{{job}}" } ],
      "fieldConfig": { "defaults": {
        "mappings": [ { "type": "value", "options": {
          "0": { "text": "DOWN", "color": "red" },
          "1": { "text": "UP", "color": "green" } } } ] } }
    },
    {
      "id": 2, "type": "timeseries", "title": "Requests per Second",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{http_route!~\"/metrics|/health.*\"}[1m]))", "legendFormat": "{{job}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 3, "type": "timeseries", "title": "5xx Errors",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (job) (rate(http_server_request_duration_seconds_count{http_response_status_code=~\"5..\"}[1m]))", "legendFormat": "{{job}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 4, "type": "timeseries", "title": "Latency p50 / p95 / p99",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/metrics|/health.*\"}[5m])))", "legendFormat": "p50 {{job}}" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/metrics|/health.*\"}[5m])))", "legendFormat": "p95 {{job}}" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/metrics|/health.*\"}[5m])))", "legendFormat": "p99 {{job}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 5, "type": "timeseries", "title": "Average Duration by Route",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_sum{http_route!~\"/metrics|/health.*\"}[5m])) / sum by (http_route) (rate(http_server_request_duration_seconds_count{http_route!~\"/metrics|/health.*\"}[5m]))", "legendFormat": "{{http_route}}" } ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },
    {
      "id": 6, "type": "timeseries", "title": "Active Kestrel Connections",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (job) (kestrel_active_connections)", "legendFormat": "{{job}}" } ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Responses by Status Code",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{http_route!~\"/metrics|/health.*\"}[1m]))", "legendFormat": "{{http_response_status_code}}" } ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    }
  ]
}